{
  "title": "Oceananigans hydrostatic and nonhydrostatic in Float32: NVTX Nsight on 1 and 2 GPUs",
  "commit_subject": "Record Oceananigans Float32 1- and 2-GPU Nsight campaign",
  "description": [
    "Float32 repeat of the Oceananigans captures (2026-11-19 and 2026-11-25 ran Float64), so the",
    "Oceananigans models use the same precision as the Breeze anelastic, CE and CSE captures.",
    "HydrostaticFreeSurfaceModel (SplitRungeKutta3, SplitExplicitFreeSurface, 30 substeps) and",
    "NonhydrostaticModel (RungeKutta3) on the rectilinear_buoyancy workload, WENO5, Δt = 10 s.",
    "Per model: 512×512×512 on one GPU serial (`_1g`), the same on one rank with NCCLDistributed",
    "and a 1×1 partition (`_1gd`, --distributed=true), and 1024×512×512 on two GPUs with NCCL",
    "(`_2g`). Oceananigans host NVTX ranges.",
    "The serial nonhydrostatic_1g case was dropped on 2026-11-26 (not needed for the 1-vs-2-GPU tables)."
  ],
  "local_size": [
    512,
    512,
    512
  ],
  "warmup_steps": 10,
  "measured_steps": 10,
  "nvtx": true,
  "nsight_trace": [
    "cuda",
    "nvtx",
    "mpi"
  ],
  "common_arguments": [],
  "cases": [
    {
      "name": "hydrostatic_1g",
      "dynamics": "oceananigans_hydrostatic",
      "ranks": 1,
      "size": "512x512x512",
      "partition": "1x1",
      "arguments": [
        "--float_type=Float32",
        "--time_step=10",
        "--comm=NCCL"
      ]
    },
    {
      "name": "hydrostatic_1gd",
      "dynamics": "oceananigans_hydrostatic",
      "ranks": 1,
      "size": "512x512x512",
      "partition": "1x1",
      "arguments": [
        "--float_type=Float32",
        "--time_step=10",
        "--comm=NCCL",
        "--distributed=true"
      ]
    },
    {
      "name": "hydrostatic_2g",
      "dynamics": "oceananigans_hydrostatic",
      "ranks": 2,
      "size": "1024x512x512",
      "partition": "2x1",
      "arguments": [
        "--float_type=Float32",
        "--time_step=10",
        "--comm=NCCL"
      ]
    },
    {
      "name": "nonhydrostatic_1gd",
