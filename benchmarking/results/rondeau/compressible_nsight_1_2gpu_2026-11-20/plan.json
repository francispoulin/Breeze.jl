{
  "title": "Breeze compressible explicit and split-explicit: NVTX Nsight on 1 and 2 GPUs",
  "commit_subject": "Record CE and CSE 1- and 2-GPU Nsight campaign",
  "description": [
    "512³ cells per A100: 512×512×512 on one GPU (no inter-rank communication) and",
