bash "$OCEAN_HPC_ROOT/tools/run_local.sh" --wait -n 2 --gpu-ids 1,2 -p "$BREEZE_DISTRIBUTED_DIR" --job-name pilot_nccl_explicit "$BREEZE_DISTRIBUTED_DIR/distributed_cbl_benchmark.jl" --comm=NCCL --dynamics=compressible_explicit --size=64x32x16 --partition=2x1 --warmup_steps=2 --time_steps=2 --time_step=0.02 --substeps=12 --results_file="/u/ajtse/Breeze.jl/benchmarking/results/rondeau/weak_scaling_mpi_nccl_2026-11-08_dt0p02/validation/pilot.csv"

